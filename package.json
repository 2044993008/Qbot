{
  "name": "projects",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsx scripts/run.ts build",
    "db:up": "docker compose -f docker-compose.local-db.yml up -d",
    "db:down": "docker compose -f docker-compose.local-db.yml down",
    "db:init": "docker compose -f docker-compose.local-db.yml exec -T postgres psql -U postgres -d app -f /workspace/scripts/init-local-db.sql",
    "db:migrate:20260428": "docker compose -f docker-compose.local-db.yml exec -T postgres psql -U postgres -d app -f /workspace/scripts/migrations/20260428_add_unique_indexes.sql",
    "db:seed": "tsx scripts/seed-local-db.ts",
    "dev": "tsx scripts/run.ts dev",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint",
    "start": "tsx scripts/run.ts start",
    "ts-check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
